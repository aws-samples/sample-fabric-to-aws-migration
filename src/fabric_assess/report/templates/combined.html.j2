<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>fabric-assess — {{ a.workspace or "Fabric Warehouse" }}</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
         margin: 0; padding: 2rem; line-height: 1.5;
         background: #0b0c0e; color: #e6e6e6; }
  @media (prefers-color-scheme: light) { body { background: #f6f7f9; color: #1a1a1a; } }
  h1 { font-size: 1.5rem; margin: 0 0 .25rem; }
  .sub { opacity: .7; margin: 0 0 1.5rem; font-size: .9rem; }
  .cards { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
  .card { flex: 1 1 180px; background: rgba(127,127,127,.12); border-radius: 10px;
          padding: 1rem 1.25rem; }
  .card .n { font-size: 1.8rem; font-weight: 700; }
  .card .l { opacity: .7; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
  .axis { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .axis > div { flex: 1 1 300px; background: rgba(127,127,127,.08); border-radius: 10px; padding: 1rem; }
  .bar { display: flex; height: 1.5rem; border-radius: 6px; overflow: hidden; margin: .5rem 0; }
  .seg { display: flex; align-items: center; justify-content: center; font-size: .75rem; color: #fff; }
  .auto, .portable { background: #2e7d32; }
  .assisted, .adapt { background: #e68a00; }
  .manual, .rewrite { background: #c62828; }
  table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid rgba(127,127,127,.2); }
  th { opacity: .7; font-weight: 600; }
  .tag { display: inline-block; padding: .1rem .5rem; border-radius: 999px; font-size: .72rem; color: #fff; }
  .disclaimer { margin-top: 2rem; font-size: .78rem; opacity: .65; border-top: 1px solid rgba(127,127,127,.2);
                padding-top: 1rem; }
</style>
</head>
<body>
  <h1>Microsoft Fabric → AWS lakehouse migration assessment</h1>
  <p class="sub">
    Workspace: {{ a.workspace or "(unnamed)" }} ·
    {{ a.summary.total_entities }} entities ·
    {{ a.summary.total_tables }} tables ·
    {{ "%.1f"|format(a.summary.total_size_gb) }} GB ·
    generated {{ a.generated_at }}
  </p>

  <div class="cards">
    <div class="card"><div class="n">{{ a.summary.total_tables }}</div><div class="l">Tables</div></div>
    <div class="card"><div class="n">{{ a.summary.total_entities }}</div><div class="l">Entities</div></div>
    <div class="card"><div class="n">{{ "%.0f"|format(a.summary.total_size_gb) }} GB</div><div class="l">Logical size</div></div>
    <div class="card"><div class="n">{{ a.summary.sql_surface_confidence }}</div><div class="l">Surface confidence</div></div>
  </div>

  <div class="axis">
    <div>
      <strong>Migration Effort</strong> (moving the data)
      <div class="bar">
        {% for k, cls in [("AUTO","auto"),("ASSISTED","assisted"),("MANUAL","manual")] %}
          {% set n = a.summary.effort_counts.get(k, 0) %}
          {% if n %}<div class="seg {{ cls }}" style="flex:{{ n }}">{{ k }} {{ n }}</div>{% endif %}
        {% endfor %}
      </div>
      <small>Open-format OneLake source trends toward AUTO.</small>
    </div>
    <div>
      <strong>Query Complexity</strong> (keeping the T-SQL running)
      <div class="bar">
        {% for k, cls in [("PORTABLE","portable"),("ADAPT","adapt"),("REWRITE","rewrite")] %}
          {% set n = a.summary.complexity_counts.get(k, 0) %}
          {% if n %}<div class="seg {{ cls }}" style="flex:{{ n }}">{{ k }} {{ n }}</div>{% endif %}
        {% endfor %}
      </div>
      <small>T-SQL constructs drive the rewrite effort.</small>
    </div>
  </div>

  <h2 style="font-size:1.1rem">Entities</h2>
  <table>
    <thead><tr><th>Entity</th><th>Type</th><th>Size (GB)</th><th>Effort</th><th>Strategy</th><th>Complexity</th></tr></thead>
    <tbody>
    {% for e in a.entities %}
      <tr>
        <td>{{ e.full_name }}</td>
        <td>{{ e.entity_type }}</td>
        <td>{{ "%.2f"|format(e.size_gb) }}</td>
        <td>{% if e.effort %}<span class="tag {{ e.effort.category|lower }}">{{ e.effort.category }}</span>{% else %}—{% endif %}</td>
        <td>{% if e.effort %}{{ e.effort.strategy|replace("_"," ") }}{% else %}—{% endif %}</td>
        <td>{% if e.complexity %}<span class="tag {{ e.complexity.category|lower }}">{{ e.complexity.category }}</span>{% else %}—{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  {% if a.failures %}
  <h2 style="font-size:1.1rem">Scan / scoring failures ({{ a.failures|length }})</h2>
  <table>
    <thead><tr><th>Entity</th><th>Stage</th><th>Error</th></tr></thead>
    <tbody>{% for f in a.failures %}<tr><td>{{ f.entity_name }}</td><td>{{ f.stage }}</td><td>{{ f.error }}</td></tr>{% endfor %}</tbody>
  </table>
  {% endif %}

  <p class="disclaimer">
    Alpha companion sample. This tool <strong>assesses; it does not execute the migration</strong>.
    Cost figures are directional estimates (public us-east-1 rates) — validate with the AWS Pricing
    Calculator before any decision. SQL surfaces shown are anonymized (literals stripped).
    Review all assessments with your AWS specialist team.
  </p>
</body>
</html>
